{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for document and settings windows. File access goes through our own narrow commands, so no fs or shell plugin is granted.",
  "windows": ["doc-*", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-set-size",
    "opener:allow-open-url",
    "opener:allow-default-urls"
  ]
}
