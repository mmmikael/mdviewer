{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDViewer",
  "version": "0.3.0",
  "identifier": "com.mmmikael.mdviewer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "bash quicklook/build.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' mdvres:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https: http: data: blob:",
        "media-src": "'self' asset: http://asset.localhost https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "A small Markdown viewer",
    "copyright": "© 2026 Mikael Rousson",
    "resources": {
      "resources/Help.md": "resources/Help.md"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mkdn",
          "mdwn"
        ],
        "contentTypes": [
          "net.daringfireball.markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Viewer",
        "rank": "Default"
      },
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mkdn",
          "mdwn",
          "mdx"
        ],
        "name": "Markdown File",
        "role": "Viewer",
        "rank": "Default"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "files": {
        "PlugIns/MDViewerQuickLook.appex": "target/quicklook/MDViewerQuickLook.appex"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
